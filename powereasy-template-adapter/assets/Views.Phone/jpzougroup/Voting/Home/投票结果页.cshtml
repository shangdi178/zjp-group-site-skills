@*投票结果页模板*@
@inject NodeService NodeService

@model Vote
@{
    Layout = $"~/Views.Phone/{this.Context.GetCurrentSite().Identifier}/Layout/公共布局页.cshtml";
    ViewBag.bodyClass = "voteResultPage";
    var node = NodeService.GetNodeByIdentifier("zxtp");
    ViewBag.PageTitle = "投票结果_" + node.NodeName + this.Context.GetCurrentSite().SiteTitle;
    ViewBag.HeaderTitle = "投票结果";
    int count = ViewBag.VoteNumber;
    var voteItems = ViewBag.VoteItems as List<VoteItem>;
}

@section header{
    <link href="~/content.phone/_common/voting/css/vote.css" asp-append-version="true" rel="stylesheet" />
}

<div class="path">@Power.Partial("位置导航", new { Node = node })</div>

<!-- content S -->
<div id="content">

    <!-- 正文内容 S -->
    <div class="graphPater">
        <div class="graphTitle">
            <span class="result-title">
                @(Model.Title)
            </span>

        </div>

        <div class="surveyInfo">
            <span class="result-type">
                <label>类型:</label>
                @if (Model.VoteType.ToString() == "Single")
                {
                    <span>单选</span>
                }
                else
                {
                    <span>多选</span>
                }

                <label>总得票数:</label><span>@count</span>
            </span>
            <span>开始时间:@(Model.BeginTime)</span>
            <span>结束时间:@(Model.EndTime)</span>
        </div>

        <div class="graphContent">
            @if (voteItems != null)
            {
                <div id="ResultsPie" style="height:@(this.ViewBag.ResultsPieHeight)px" class="result-chart"></div>
                <table border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <th class="a">选项</th>
                        <th class="b">得票数</th>
                        <th class="c">占比</th>
                    </tr>

                    @foreach (var voteItem in voteItems.OrderByDescending(x => x.VoteNumber))
                    {
                        <tr>
                            <td>@voteItem.Title</td>
                            <td>@voteItem.VoteNumber</td>
                            <td>(@((voteItem.VoteNumber / (double)count * 100).ToString("0.00"))%)</td>
                        </tr>
                    }

                </table>
            }
        </div>
    </div>
    <input type="hidden" name="results" value="@JsonConvert.SerializeObject(voteItems)" id="Results" />

    <!-- 正文内容 E -->

</div>
<!-- content E -->

@section scripts
{
    <script src="~/content/_common/assets/scripts/echarts.js" asp-append-version="true"></script>
    <script src="~/content/_common/voting/js/power-vote-statistics.js" asp-append-version="true"></script>
}