@*问卷调查提交成功页模板*@
@inject NodeService NodeService

@model Questionnaire
@{
    Layout = $"~/Views.Phone/{this.Context.GetCurrentSite().Identifier}/Layout/公共布局页.cshtml";
    ViewBag.bodyClass = "surveyTipsPage";
    var node = NodeService.GetNodeByIdentifier("wjtc");
    ViewBag.PageTitle = "提交成功_" + node.NodeName + this.Context.GetCurrentSite().SiteTitle;
    ViewBag.HeaderTitle = "提交成功";
}
@section header{
    <link href="~/content.phone/@(this.Context.GetCurrentSite().Identifier)/contentmanage/css/page.css" asp-append-version="true" rel="stylesheet" />
}

<div class="path">@Power.Partial("位置导航", new { Node = node })</div>

<div id="content">

    <div class="Showms">
        <dl class="content">
            <dd class="content1">
                <div class="MS">
                    <dl>
                        <dt class="titWrong">提交成功！</dt>
                        <dd>感谢您的填写</dd>
                    </dl>
                </div>
                <div class="clearbox"></div>
                <div class="BUT">
                    <a href="@Url.Action("List")" target="_blank">返回列表</a>
                    @if (Model.EnablePublic)
                    {
                        <a href="@this.ViewBag.StatisticsUrl" target="_blank">查看结果</a>
                    }
                </div>
            </dd>
        </dl>
    </div>

</div>