@*问卷调查提示页模板*@
@model Questionnaire
@{
    Layout = $"~/Views/{this.Context.GetCurrentSite().Identifier}/Layout/公共布局页.cshtml";
    ViewBag.NavigationIdentifier.Add("wjtc");
    var node = NodeService.GetNodeByIdentifier("wjtc");
    ViewBag.PageTitle = "问卷调查提示_" + this.Context.GetCurrentSite().SiteTitle;
    ViewBag.bodyClass = "surveyTipsPage";
}
@section header
{
    <link href="~/content/@(this.Context.GetCurrentSite().Identifier)/contentmanage/css/page.css" asp-append-version="true" rel="stylesheet" />
}
@section scripts
{
    <script src="~/content/_common/survey/js/surveywinclose.js" asp-append-version="true"></script>
}

<!-- content S -->
<div id="content" class="noSideContent">
    <!-- mainContent S -->
    <div class="mainContent">
        <div class="mainBox">
            <div class="mHd">
                <div class="path">@Power.Partial("位置导航", new { Node = node })</div>
                <h3><span>@(node?.NodeName)</span></h3>
            </div>
            <div class="mBd">

                <!-- 正文内容 S -->
                <div class="Showms">
                    <div class="MS">
                        <dl>
                            <dt class="titWrong">信息提示</dt>
                            <dd>@ViewBag.Message</dd>
                        </dl>
                    </div>
                    <div class="clearbox"></div>
                    <div class="BUT">
                        @* <a id="LnkReturnUrl" href="javascript:window.close();">关闭</a> *@
@inject NodeService NodeService

                        <a href="@Url.Action("List")" target="_blank">返回列表</a>
                    </div>
                </div>
                <!-- 正文内容 E -->

            </div>
        </div>
    </div>
    <!-- mainContent E -->
</div>
<!-- content E -->
