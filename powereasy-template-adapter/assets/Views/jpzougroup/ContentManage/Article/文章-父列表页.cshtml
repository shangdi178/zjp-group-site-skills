@*列表页模板*@
@inject NodeService NodeService
@inject NodeInterfaceExtend NodeInterfaceExtend

@Power.VisualizationView(new { Area = "ContentManage", Controller = "Node"})
@model Node
@{
    Layout = $"~/Views/{this.Context.GetCurrentSite().Identifier}/Layout/公共布局页.cshtml";
}
@section header {
    <link href="~/content/@(this.Context.GetCurrentSite().Identifier)/contentmanage/css/page.css" asp-append-version="true" rel="stylesheet" />
}

<!-- content S -->
<div id="content">
    <!-- side S -->
    <aside class="side">
        @Power.Partial("侧栏-通用", new { Node = Model , ShowHotNews = true})
    </aside>
    <!-- side E -->
    <!-- mainContent S -->
    <div class="mainContent">
        <div class="mainBox">
            <div class="mHd">
                <div class="path">@Power.Partial("位置导航", new { Node = Model })</div>
@NodeInterfaceExtend.NodeHits(Model)
                <h3><span>@Model.NodeName</span></h3>
            </div>
            <div class="mBd">

                <!-- 正文内容 S -->
                <div class="focusWrap">
                    <!-- 焦点图 -->
                    <div class="focusBox">
                        @Power.Partial("文章焦点图", new { Count = 4, NodeIdentifier = Model.Identifier, TitleLength = 34, PicTitle = false, ImageWidth = 350, ImageHeight = 260, Sort = "Priority DESC,PublishTime DESC" })
                    </div>
                    <script language="javascript"> jQuery(".focusBox").slide({ mainCell: ".bd ul", effect: "fade", autoPlay: true, interTime: 4000 });</script>

                    <ul class="topicList">
                        @Power.ArticleList("文章头条列表", new { Count = 7, Node = Model.Identifier, TitleLength = 70, TopicNum = 1, TopicTitleLength = 66, TopicContentLength = 170, TopicDisplayPic = false, ImageWidth=126, ImageHeight=95, Sort="Priority,PublishTime",DisplayDateTime="MM-dd", RefNode = true })
                    </ul>
                </div>
                <!-- 栏目循环 S -->
                <div class="pageBoxLoop">
                @{
                    var nodeService = NodeService;
                    var childNodes = nodeService.GetChildNodeList(Model).Take(999);
                    var index = 1;
                    var pageFloat = "fl";
                    foreach (Node childNode in childNodes.Where(n => n.ShowOnParentNodeList))
                    {
                        pageFloat=index%2==0?"fr":"fl";
                        index++;
                        <div class="box @pageFloat">
                            <div class="hd ">
                                @Power.Url.NodeLink(childNode.Identifier, "更多>>",new { @class="more" })
                                <h3>@Power.Url.NodeLink(childNode.Identifier)</h3>
                            </div>
                            <div class="bd">
                                @if (childNode.MoldId == 2)
                                {
                                    <ul class="infoList">
                                        @Power.PhotoList("图片标题列表", new { Count = 6, Node = childNode.Identifier, TitleLength = 54, DateFormat = "MM-dd", Sort = "Hits", RefNode = true })
                                    </ul>
                                }
                                else if (childNode.MoldId == 3)
                                {
                                    <ul class="infoList">
                                        @Power.VideoList("视频标题列表", new { Count = 6, Node = childNode.Identifier, TitleLength = 54, DateFormat = "MM-dd", Sort = "Hits", RefNode = true })
                                    </ul>
                                }
                                else
                                {
                                    <ul class="infoList">
                                        @Power.ArticleList("文章标题列表", new { Count = 6, Node = childNode.Identifier, TitleLength = 54, DateFormat = "MM-dd", RefNode = true })
                                    </ul>
                                }
                            </div>
                        </div>
                    }
                }
                </div>
                <!-- 栏目循环 E -->
                <!-- 正文内容 E -->

            </div>
        </div>
    </div>
    <!-- mainContent E -->
</div>
<!-- content E -->